# Configure these values in .env.local after creating the Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REQUEST_TOKEN_SECRET=

# Pagar.me v5 sandbox only. Leave blank until PSP/split access is available.
# A production secret is intentionally rejected by the current adapter.
PAGARME_SECRET_KEY=
