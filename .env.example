# Configure these values in .env.local after creating the Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
REQUEST_TOKEN_SECRET=

# Token gratuito do ListenBrainz (https://listenbrainz.org/settings/), usado só por npm run marcar:populares.
LISTENBRAINZ_TOKEN=
